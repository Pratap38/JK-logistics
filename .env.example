# Copy to .env for local testing with `netlify dev`.
# On the live site these go in Netlify -> Site settings -> Environment variables.
# Never commit the real values.

# jklogistics.co.uk mail is hosted by IONOS (its MX records are mx00/mx01.ionos.co.uk),
# so these two are already correct — no need to look them up.
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=465
# 465 is IONOS's primary port (SSL/TLS). If it is blocked, use 587 — the code
# switches to STARTTLS on its own when the port is not 465.

# IONOS signs in with the full email address, never a short username.
SMTP_USER=hello@jklogistics.co.uk

# The only value that has to be fetched — the password for that mailbox.
# Put the REAL password in .env (git-ignored), never in this file — this one is committed.
SMTP_PASS=your-mailbox-password

# Where enquiries land.
MAIL_TO=hello@jklogistics.co.uk

# Must be the mailbox SMTP_USER authenticates as, or SPF/DMARC will reject the message.
# The visitor's address goes in Reply-To instead, so replying from the inbox reaches them.
MAIL_FROM=JK Logistics Website <hello@jklogistics.co.uk>
